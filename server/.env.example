# =================================================================
# Faculty Leave Management System - Backend Environment Configuration
# =================================================================

# Server Port and Environment Mode
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas Replica Set or Sharded Cluster required for transactions)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/facultyleave?retryWrites=true&w=majority

# JWT Authentication Secret and Token Expiry
# Generate a cryptographically secure random string with at least 32 characters
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
FRONTEND_URL=https://your-frontend-deployment.railway.app

# Outbox Payload Encryption Key (AES-256-GCM)
# 64-character hexadecimal string (32 bytes). Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` to generate
OUTBOX_ENCRYPTION_KEY=replace_with_64_character_hex_key

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=xkeysib-replace_with_your_brevo_api_key
SMTP_FROM_NAME="Faculty Leave System"
SMTP_FROM_EMAIL=notifications@yourdomain.edu

# =================================================================
# Initial One-Time Admin Bootstrap (Railway Environment Variables)
# =================================================================
# These variables are used for the one-time atomic bootstrap when no Admin
# exists in the database.
# Password requirements: at least 8 characters, with at least one uppercase
# letter, one lowercase letter, and one number.
# After bootstrap succeeds, you can safely remove these variables from Railway.
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.edu
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Optional Admin Profile Attributes (Defaults used if omitted)
# BOOTSTRAP_ADMIN_NAME="System Administrator"
# BOOTSTRAP_ADMIN_EMPLOYEE_ID="EMP-ADMIN-001"
# BOOTSTRAP_ADMIN_DESIGNATION="System Administrator"
