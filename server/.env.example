PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/faculty_leave_db
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Email Configurations (Nodemailer)
# If left blank, server will attempt to auto-configure an Ethereal Email test account.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Faculty Leave System <noreply@college.edu>
